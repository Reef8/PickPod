<!-- Hero Section -->
<section class="section-lg" style="padding-top: 12rem; background: var(--color-light-gray);">
  <div class="container text-center">
    <span class="label">Our Story</span>
    <h1 class="headline-xl mb-4">
      Born from necessity.
    </h1>
    <div class="divider divider-center"></div>
    <p class="subheadline" style="max-width: 600px; margin: 0 auto;">
      The story behind PickPod
    </p>
  </div>
</section>

<!-- Story Section -->
<section class="section">
  <div class="container-narrow">
    <div class="mb-6">
      <span class="label">The Beginning</span>
      <h2 class="headline-md mb-4">A common problem, overlooked.</h2>
      <div class="divider"></div>
    </div>
    <p class="body-lg mb-5">
      PickPod was created by Salim Khan after discovering a common yet overlooked challenge: the only time available for flossing was during his commute.
    </p>
    <p class="body-lg text-muted mb-5">
      After months of dealing with cluttered cup holders filled with used floss picks, he recognized an opportunity for innovation. What started as a personal frustration became a mission to help busy professionals maintain their dental health without compromise.
    </p>
    <p class="body-lg text-muted">
      The result is PickPod—a thoughtfully designed solution for individuals who prioritize dental health but lack traditional flossing time. With dedicated compartments for fresh and used picks, PickPod brings organization and convenience to on-the-go oral care.
    </p>
  </div>
</section>

<!-- Mission Section -->
<section class="split" style="min-height: 60vh;">
  <div class="split-content" style="background: var(--color-dark); color: var(--color-white);">
    <span class="label" style="color: var(--color-medium-gray);">Our Mission</span>
    <h2 class="headline-md mb-4">
      Dental care,<br>redefined.
    </h2>
    <div class="divider"></div>
    <p class="body-lg" style="color: rgba(255,255,255,0.7);">
      To make dental hygiene accessible and convenient for everyone, regardless of how busy life gets.
    </p>
    <p class="body-base mt-4" style="color: rgba(255,255,255,0.5);">
      Because maintaining a healthy smile shouldn't require sacrificing your daily routine.
    </p>
  </div>
  <div class="split-image" style="background: var(--color-light-gray);">
    <img src="/images/pickpod-product.png" alt="PickPod Product" style="object-fit: contain; padding: 4rem;">
  </div>
</section>

<!-- Values Section -->
<section class="section-light">
  <div class="container text-center mb-6">
    <span class="label">What We Believe</span>
    <h2 class="headline-lg">Our Values</h2>
  </div>
  <div class="feature-grid">
    <div class="feature-item">
      <span class="feature-number">01</span>
      <h3 class="feature-title">Simplicity</h3>
      <p class="body-sm text-muted">
        The best solutions are elegant in their simplicity. No complexity, just function.
      </p>
    </div>
    <div class="feature-item">
      <span class="feature-number">02</span>
      <h3 class="feature-title">Quality</h3>
      <p class="body-sm text-muted">
        Every detail matters. We obsess over materials, finish, and user experience.
      </p>
    </div>
    <div class="feature-item">
      <span class="feature-number">03</span>
      <h3 class="feature-title">Accessibility</h3>
      <p class="body-sm text-muted">
        Health shouldn't be complicated. We make dental care fit your lifestyle.
      </p>
    </div>
  </div>
</section>

<!-- CTA Section -->
<section class="section-lg section-black">
  <div class="container text-center">
    <span class="label" style="color: var(--color-medium-gray);">Get Started</span>
    <h2 class="headline-lg mb-4" style="color: var(--color-white);">
      Ready to transform your routine?
    </h2>
    <p class="body-lg mb-6" style="color: rgba(255,255,255,0.5); max-width: 500px; margin-left: auto; margin-right: auto;">
      Join the movement toward convenient, on-the-go dental care.
    </p>
    <a href="/" class="btn btn-primary">Explore PickPod</a>
  </div>
</section>

