<%!-- CTA Section --%>
<section class="section">
  <div class="container">
    <div class="signup-box animate-scale-in">
      <span class="label">Join Them</span>
      <h2 class="headline-md mb-3">
        Ready to transform your routine?
      </h2>
      <p
        class="body-lg text-muted mb-5"
        style="max-width: 500px; margin-left: auto; margin-right: auto;"
      >
        Be the first to experience PickPod when we launch.
      </p>
      <a href="/#notify" class="btn btn-primary btn-lg">Join the Waitlist</a>
    </div>
  </div>
</section>

<.site_footer />
