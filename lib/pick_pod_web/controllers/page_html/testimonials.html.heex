<.site_nav active={:testimonials} />

<%!-- Hero Section --%>
<section
  class="section-lg"
  style="padding-top: 8rem; padding-bottom: 4rem; background: var(--color-white);"
>
  <div class="container text-center">
    <span class="label animate-fade-up animated">Testimonials</span>
    <h1 class="headline-xl mb-4 animate-fade-up animated delay-100">
      What people are <span class="text-gradient">saying.</span>
    </h1>
    <p
      class="subheadline animate-fade-up animated delay-200"
      style="max-width: 540px; margin: 0 auto;"
    >
      Early adopters share their experience with PickPod
    </p>
  </div>
</section>

<%!-- Testimonials Grid --%>
<section class="section">
  <div class="container">
    <div class="testimonials-grid animate-stagger">
      <%!-- Testimonial 1 --%>
      <div class="testimonial-card animate-fade-up">
        <div class="testimonial-stars">
          <span>★</span><span>★</span><span>★</span><span>★</span><span>★</span>
        </div>
        <p class="testimonial-text">
          "Finally, a solution for my car flossing habit! No more loose picks rolling around my cup holder. The dual-chamber design is genius."
        </p>
        <div class="testimonial-author">
          <div class="testimonial-avatar">SK</div>
          <div class="testimonial-info">
            <div class="testimonial-name">Sarah Kim</div>
            <div class="testimonial-title">Marketing Director, NYC</div>
          </div>
        </div>
      </div>

      <%!-- Testimonial 2 --%>
      <div class="testimonial-card testimonial-featured animate-fade-up">
        <div class="testimonial-stars">
          <span>★</span><span>★</span><span>★</span><span>★</span><span>★</span>
        </div>
        <p class="testimonial-text">
