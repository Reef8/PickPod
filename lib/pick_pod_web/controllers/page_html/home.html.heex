<.site_nav active={:home} />

<%!-- Hero Section --%>
<section class="hero">
  <div class="container">
    <div class="hero-split">
      <div class="hero-text">
        <span class="hero-badge animate-fade-up animated">Version 2 Coming Soon</span>
        <h1 class="headline-xl mb-3 animate-fade-up animated delay-100">
          Made for people who floss in their car.
        </h1>
        <p class="body-lg text-muted animate-fade-up animated delay-150">
          PickPod keeps fresh picks organized and used ones out of sight.
        </p>
      </div>
      <div class="hero-image animate-scale-in animated delay-200">
        <img src="/images/pickpod3.PNG" alt="PickPod Product" />
      </div>
    </div>
    <%!-- Signup Section - Centered Below Hero --%>
    <div class="hero-signup-centered animate-fade-up animated delay-300">
      <p class="hero-signup-label">Join 2,000+ on the waitlist</p>
      <%= if @form_status == :success do %>
        <div class="signup-success">
          <p>You're on the list! Check your email for confirmation.</p>
        </div>
      <% else %>
        <.form for={@form} action={~p"/subscribe"} class="signup-form" id="hero-signup-form">
          <div class="form-field">
            <.input
              field={@form[:email]}
              type="email"
              placeholder="Enter your email"
              required
              class="form-input"
              error_class="form-input-error"
            />
          </div>
          <button type="submit" class="btn btn-primary btn-lg">
            Notify Me
          </button>
        </.form>
      <% end %>
    </div>
    <%!-- Mini Testimonials Strip --%>
    <div class="hero-testimonials animate-fade-up animated delay-400">
      <div class="hero-testimonial-item">
        <div class="hero-testimonial-stars">★★★★★</div>
        <p class="hero-testimonial-text">
          "Finally, a solution for my messy car flossing habit!"
        </p>
        <span class="hero-testimonial-author">— Sarah K., NYC</span>
      </div>
      <div class="hero-testimonial-item">
        <div class="hero-testimonial-stars">★★★★★</div>
        <p class="hero-testimonial-text">"Game changer for after lunch meetings."</p>
        <span class="hero-testimonial-author">— Michael J., LA</span>
      </div>
      <div class="hero-testimonial-item">
        <div class="hero-testimonial-stars">★★★★★</div>
        <p class="hero-testimonial-text">"PickPod helped me turn flossing into a daily habit."</p>
        <span class="hero-testimonial-author">— Emma R., Chicago</span>
      </div>
    </div>
  </div>
</section>

<%!-- Problem Section --%>
<section id="product" class="section">
  <div class="container text-center">
    <span class="label animate-on-scroll">Glovebox Graveyards</span>
    <h2 class="headline-lg mb-4 animate-on-scroll">
      The flossing problem everyone ignores.
    </h2>
    <p class="body-lg animate-on-scroll" style="max-width: 600px; margin: 0 auto;">
      Floss picks in your car end up everywhere—cupholders, door pockets, center consoles. Messy, unsanitary, forgotten.
    </p>
  </div>
</section>

<%!-- Lifestyle Story --%>
<section id="lifestyle" class="section lifestyle-section">
  <div class="container">
    <div class="lifestyle-heading">
      <div>
        <span class="label animate-on-scroll">From scattered to sorted</span>
        <h2 class="headline-lg animate-on-scroll">A cleaner place for every pick.</h2>
      </div>
      <p class="body-lg text-muted animate-on-scroll">
        Fresh picks stay within reach. Used picks stay contained until it is time to empty the pod.
      </p>
    </div>
    <div class="lifestyle-grid animate-stagger">
      <figure class="lifestyle-card lifestyle-card-problem animate-fade-up">
        <div class="lifestyle-image-wrap">
          <img
            src={~p"/images/glovebox-graveyard.webp"}
            alt="Loose floss picks scattered across car cupholders and a center-console pocket"
            loading="lazy"
            width="1440"
            height="960"
          />
          <span class="lifestyle-chip">Before</span>
        </div>
        <figcaption>
          <strong>Glovebox graveyards.</strong>
          Cupholders, door pockets, and consoles were never meant to be disposal bins.
        </figcaption>
      </figure>
      <figure class="lifestyle-card lifestyle-card-solution animate-fade-up">
        <div class="lifestyle-image-wrap">
          <img
            src={~p"/images/pickpod-in-car.webp"}
            alt="A hand taking a clean floss pick from PickPod in a parked car cupholder"
            loading="lazy"
            width="1440"
            height="960"
          />
          <span class="lifestyle-chip">After</span>
        </div>
        <figcaption>
          <strong>One simple routine.</strong>
          Keep clean picks ready, then tuck used ones out of sight in the second chamber.
        </figcaption>
      </figure>
    </div>
  </div>
</section>

<%!-- Solution Section --%>
<section class="section-light section">
  <div class="container">
    <div class="hero-split" style="gap: 5rem;">
      <div class="hero-image animate-slide-left">
        <img src="/images/pickpod3.PNG" alt="PickPod Product" style="max-width: 400px;" />
      </div>
      <div>
        <span class="label animate-on-scroll">The Solution</span>
        <h2 class="headline-md mb-3 animate-on-scroll">
          Organized. Accessible. Clean.
        </h2>
        <div class="divider animate-on-scroll"></div>
        <p class="body-lg mb-4 animate-on-scroll">
          PickPod fits seamlessly in all cup holders, keeping fresh picks easily accessible and used picks out of sight.
        </p>
        <p class="body-base text-muted mb-5 animate-on-scroll">
          Two chambers. One for fresh picks, one for used. Clean, simple, smart.
        </p>
        <a href="#features" class="btn btn-secondary animate-on-scroll">See Features</a>
      </div>
    </div>
  </div>
</section>

<%!-- Features Section --%>
<section id="features" class="section">
  <div class="container">
    <div class="text-center mb-6">
      <span class="label animate-on-scroll">Features</span>
      <h2 class="headline-lg animate-on-scroll">Designed with intention.</h2>
    </div>
    <div class="feature-grid animate-stagger">
      <div class="feature-item animate-fade-up">
        <span class="feature-number">1</span>
        <h3 class="feature-title">Dual Chamber</h3>
        <p class="feature-description">
          Separate compartments for fresh and used picks. Stay organized, stay clean.
        </p>
      </div>
      <div class="feature-item animate-fade-up">
        <span class="feature-number">2</span>
        <h3 class="feature-title">Easy Install</h3>
        <p class="feature-description">
          Installs in seconds. Fits any cup holder. No tools required.
        </p>
      </div>
      <div class="feature-item animate-fade-up">
        <span class="feature-number">3</span>
        <h3 class="feature-title">Premium Design</h3>
        <p class="feature-description">
          Sleek, minimal aesthetics that complement your car's interior.
        </p>
      </div>
      <div class="feature-item animate-fade-up">
        <span class="feature-number">4</span>
        <h3 class="feature-title">Easy Dispense</h3>
        <p class="feature-description">
          Quick-click bottom releases used picks straight into the trash. No mess, no fuss.
        </p>
      </div>
    </div>
  </div>
</section>

<%!-- How It Works --%>
<section class="section">
  <div class="container">
    <div class="hero-split" style="gap: 5rem;">
      <div>
        <span class="label animate-on-scroll">How It Works</span>
        <h2 class="headline-md mb-3 animate-on-scroll">Grab. Floss. Toss.</h2>
        <p class="body-lg text-muted mb-4 animate-on-scroll">
          A daily habit, simplified into three small steps.
        </p>
        <div class="divider animate-on-scroll"></div>
        <div class="mb-4">
          <p class="body-base mb-3 animate-on-scroll">
            <strong class="text-accent">1.</strong> Place PickPod in your cup holder
          </p>
          <p class="body-base mb-3 animate-on-scroll">
            <strong class="text-accent">2.</strong> Fill the fresh chamber with floss picks
          </p>
          <p class="body-base mb-3 animate-on-scroll">
            <strong class="text-accent">3.</strong> Use and dispose in the used chamber
          </p>
          <p class="body-base animate-on-scroll">
            <strong class="text-accent">4.</strong> Empty and refill as needed
          </p>
        </div>
      </div>
      <div class="hero-image animate-slide-right">
        <img
          src="/images/pickpod3.PNG"
          alt="How to use PickPod"
          style="max-width: 100%; border-radius: var(--radius-lg);"
        />
      </div>
    </div>
  </div>
</section>

<%!-- CTA Section --%>
<section id="notify" class="section">
  <div class="container">
    <div class="signup-box animate-scale-in">
      <span class="label">Be First</span>
      <h2 class="headline-md mb-3">
        Your smile will thank you.
      </h2>
      <p
        class="body-lg text-muted mb-5"
        style="max-width: 500px; margin-left: auto; margin-right: auto;"
      >
        Join the waitlist and be the first to know when PickPod launches.
      </p>
      <%= if @form_status == :success do %>
        <div class="signup-success">
          <p>You're on the list! Check your email for confirmation.</p>
        </div>
      <% else %>
        <.form for={@form} action={~p"/subscribe"} class="signup-form" id="cta-signup-form">
          <div class="form-field">
            <.input
              field={@form[:email]}
              type="email"
              placeholder="Enter your email"
              required
              class="form-input"
              error_class="form-input-error"
            />
          </div>
          <button type="submit" class="btn btn-primary btn-lg">
            Notify Me
          </button>
        </.form>
      <% end %>
      <p class="body-sm text-muted mt-4">
        No spam. Unsubscribe anytime.
      </p>
    </div>
  </div>
</section>

<.site_footer />

<%!-- Social Proof Banner --%>
<div id="social-proof-banner" class="social-proof-banner">
  <div class="social-proof-icon">
    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
    </svg>
  </div>
  <div class="social-proof-content">
    <div class="social-proof-text" id="social-proof-text"></div>
    <div class="social-proof-time" id="social-proof-time"></div>
  </div>
  <button class="social-proof-close" id="social-proof-close" aria-label="Close notification">
    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2"
        d="M6 18L18 6M6 6l12 12"
      />
    </svg>
  </button>
</div>
