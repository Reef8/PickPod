<!-- Social Proof Banner -->
<div id="social-proof-banner" class="social-proof-banner">
  <div class="social-proof-icon">
    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
    </svg>
  </div>
  <div class="social-proof-content">
    <div class="social-proof-text" id="social-proof-text"></div>
    <div class="social-proof-time" id="social-proof-time"></div>
  </div>
  <button class="social-proof-close" id="social-proof-close" aria-label="Close notification">
    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
    </svg>
  </button>
</div>

<script>
  // Navbar scroll effect
  window.addEventListener('scroll', function() {
    const nav = document.getElementById('navbar');
    if (window.scrollY > 50) {
      nav.classList.add('nav-scrolled');
    } else {
      nav.classList.remove('nav-scrolled');
    }
  });

  // Social Proof Banner - Fake customer data
  (function() {
    const customers = [
      { name: "Sarah", city: "New York", timeAgo: "2 min ago" },
      { name: "Michael", city: "Los Angeles", timeAgo: "5 min ago" },
      { name: "Emma", city: "Chicago", timeAgo: "8 min ago" },
      { name: "James", city: "Houston", timeAgo: "12 min ago" },
      { name: "Olivia", city: "Phoenix", timeAgo: "15 min ago" },
      { name: "William", city: "Philadelphia", timeAgo: "18 min ago" },
      { name: "Sophia", city: "San Antonio", timeAgo: "22 min ago" },
      { name: "Benjamin", city: "San Diego", timeAgo: "25 min ago" },
      { name: "Isabella", city: "Dallas", timeAgo: "28 min ago" },
      { name: "Lucas", city: "Austin", timeAgo: "32 min ago" },
      { name: "Mia", city: "Seattle", timeAgo: "35 min ago" },
      { name: "Henry", city: "Denver", timeAgo: "38 min ago" },
      { name: "Charlotte", city: "Boston", timeAgo: "42 min ago" },
      { name: "Alexander", city: "Miami", timeAgo: "45 min ago" },
      { name: "Amelia", city: "Atlanta", timeAgo: "48 min ago" }
    ];

    const banner = document.getElementById('social-proof-banner');
    const textEl = document.getElementById('social-proof-text');
    const timeEl = document.getElementById('social-proof-time');
    const closeBtn = document.getElementById('social-proof-close');

    let currentIndex = 0;
    let isVisible = false;
    let isClosed = false;
    let intervalId = null;

    function showBanner() {
      if (isClosed) return;

      const customer = customers[currentIndex];
      textEl.innerHTML = `<strong>${customer.name}</strong> from ${customer.city} joined the waitlist`;
      timeEl.textContent = customer.timeAgo;

      banner.classList.add('visible');
      banner.classList.remove('hidden');
      isVisible = true;
    }

    function hideBanner() {
      banner.classList.remove('visible');
      banner.classList.add('hidden');
      isVisible = false;
    }

    function nextCustomer() {
      if (isClosed) return;

      if (isVisible) {
        hideBanner();
        setTimeout(() => {
          currentIndex = (currentIndex + 1) % customers.length;
          showBanner();
        }, 500);
      } else {
        showBanner();
      }
    }

    // Close button functionality
    closeBtn.addEventListener('click', function() {
      isClosed = true;
      hideBanner();
      if (intervalId) {
        clearInterval(intervalId);
      }
    });

    // Start after 3 seconds
    setTimeout(() => {
      showBanner();
      // Cycle every 6 seconds
      intervalId = setInterval(nextCustomer, 6000);
    }, 3000);
  })();
</script>
