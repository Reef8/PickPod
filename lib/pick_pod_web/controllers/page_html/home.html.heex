<!-- Hero Section -->
<section class="hero">
  <div class="hero-bg">
    <img src="/images/pickpod-product.png" alt="PickPod Product">
  </div>
  <div class="hero-gradient"></div>
  <div class="hero-content">
    <div class="container">
      <span class="label">Introducing PickPod</span>
      <h1 class="headline-xl mb-4">
        Floss on the go.<br>Never miss a beat.
      </h1>
      <p class="subheadline mb-6" style="max-width: 500px; color: rgba(255,255,255,0.7);">
        The dual-chamber car floss pick dispenser designed for life in motion.
      </p>
      <div style="display: flex; gap: 1rem;">
        <a href="#notify" class="btn btn-primary">Pre-Order Now</a>
        <a href="#product" class="btn btn-outline" style="border-color: rgba(255,255,255,0.3); color: white;">Discover</a>
      </div>
    </div>
  </div>
</section>

<!-- Problem Section -->
<section id="product" class="section-lg">
  <div class="container text-center">
    <span class="label">The Problem</span>
    <h2 class="headline-lg mb-4">
      The flossing problem<br>everyone ignores.
    </h2>
    <div class="divider divider-center"></div>
    <p class="body-lg text-muted" style="max-width: 600px; margin: 0 auto;">
      You know you should floss after meals. But carrying floss picks in your car?
      They end up everywhere. Messy. Inconvenient. Forgotten.
    </p>
  </div>
</section>

<!-- Solution Split Section -->
<section class="split">
  <div class="split-image" style="background: var(--color-light-gray);">
    <img src="/images/pickpod-product.png" alt="PickPod Product" style="object-fit: contain; padding: 4rem;">
  </div>
  <div class="split-content" style="background: var(--color-dark); color: var(--color-white);">
    <span class="label" style="color: var(--color-medium-gray);">The Solution</span>
    <h2 class="headline-md mb-4">
      Organized.<br>Accessible.<br>Brilliant.
    </h2>
    <div class="divider"></div>
    <p class="body-lg mb-4" style="color: rgba(255,255,255,0.7);">
      PickPod mounts seamlessly in your car, keeping fresh floss picks exactly where you need them.
    </p>
    <p class="body-base" style="color: rgba(255,255,255,0.5);">
      Two chambers. One for fresh picks, one for used. Clean, simple, smart.
    </p>
  </div>
</section>

<!-- Features Section -->
<section id="features" class="section-light">
  <div class="container text-center mb-6">
    <span class="label">Features</span>
    <h2 class="headline-lg">Every detail matters.</h2>
  </div>
  <div class="feature-grid">
    <div class="feature-item">
      <span class="feature-number">01</span>
      <h3 class="feature-title">Dual Chamber</h3>
      <p class="body-sm text-muted">
        Separate compartments for fresh and used picks. Stay organized, stay clean.
      </p>
    </div>
    <div class="feature-item">
      <span class="feature-number">02</span>
      <h3 class="feature-title">Easy Mount</h3>
      <p class="body-sm text-muted">
        Installs in seconds. Fits any car interior. No tools required.
      </p>
    </div>
    <div class="feature-item">
      <span class="feature-number">03</span>
      <h3 class="feature-title">Premium Design</h3>
      <p class="body-sm text-muted">
        Sleek, minimal aesthetics that complement your car's interior.
      </p>
    </div>
  </div>
</section>

<!-- How It Works -->
<section class="split" style="min-height: auto;">
  <div class="split-content" style="padding: 6rem 4rem;">
    <span class="label">How It Works</span>
    <h2 class="headline-md mb-4">Simple by design.</h2>
    <div class="divider"></div>
    <div class="mb-4">
      <p class="body-base mb-3"><strong style="color: var(--color-accent);">1.</strong> Mount PickPod to your preferred location</p>
      <p class="body-base mb-3"><strong style="color: var(--color-accent);">2.</strong> Fill the fresh chamber with floss picks</p>
      <p class="body-base mb-3"><strong style="color: var(--color-accent);">3.</strong> Use and dispose in the used chamber</p>
      <p class="body-base"><strong style="color: var(--color-accent);">4.</strong> Empty and refill as needed</p>
    </div>
  </div>
  <div class="split-image" style="background: var(--color-light-gray); display: flex; align-items: center; justify-content: center; padding: 2rem;">
    <img src="/images/pickpod-how-to-use.png" alt="How to use PickPod" style="max-width: 100%; max-height: 100%; object-fit: contain;">
  </div>
</section>

<!-- CTA Section -->
<section id="notify" class="section-lg section-black">
  <div class="container text-center">
    <span class="label" style="color: var(--color-medium-gray);">Be First</span>
    <h2 class="headline-lg mb-4" style="color: var(--color-white);">
      Your smile will thank you.
    </h2>
    <p class="body-lg mb-6" style="color: rgba(255,255,255,0.5); max-width: 500px; margin-left: auto; margin-right: auto;">
      Join the waitlist and be the first to know when PickPod launches.
    </p>
    <form style="max-width: 400px; margin: 0 auto;">
      <div class="form-group">
        <input
          type="email"
          placeholder="Enter your email"
          class="form-input form-input-dark"
          required
        />
      </div>
      <button type="submit" class="btn btn-primary" style="width: 100%;">
        Notify Me
      </button>
    </form>
    <p class="body-sm mt-4" style="color: var(--color-medium-gray);">
      No spam. Unsubscribe anytime.
    </p>
  </div>
</section>

