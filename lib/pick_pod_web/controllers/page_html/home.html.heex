<!-- Hero Section -->
<section class="hero">
  <div class="apple-container" style="padding: 60px 20px;">
    <h1 class="apple-headline" style="margin-bottom: 24px;">
      Floss on the go.<br>Never miss a beat.
    </h1>
    <p class="apple-subheadline" style="margin-bottom: 40px;">
      The dual-chamber car floss pick dispenser that keeps your smile fresh wherever you drive.
    </p>
    <div style="display: flex; gap: 16px; justify-content: center;">
      <a href="#buy" class="apple-button">Buy Now</a>
      <a href="#learn-more" class="apple-button apple-button-outline">Learn More</a>
    </div>
  </div>
</section>

<!-- Problem Section -->
<section class="apple-section" style="background: white;">
  <div class="apple-container" style="text-align: center;">
    <h2 class="apple-headline" style="font-size: 48px; margin-bottom: 20px;">
      The flossing problem<br>everyone ignores.
    </h2>
    <p class="apple-subheadline" style="max-width: 700px; margin: 0 auto 60px;">
      You know you should floss after meals. But carrying floss picks in your car? They end up everywhere. Messy. Inconvenient. Forgotten.
    </p>
  </div>
</section>

<!-- Solution Section -->
<section class="apple-section" style="background: var(--apple-gray-light);">
  <div class="apple-container">
    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 60px; align-items: center;">
      <div>
        <h2 class="apple-headline" style="font-size: 40px; margin-bottom: 20px;">
          Organized.<br>Accessible.<br>Brilliant.
        </h2>
        <p class="apple-body" style="margin-bottom: 20px;">
          PickPod mounts seamlessly in your car, keeping fresh floss picks exactly where you need them. Two chambers. One for fresh picks, one for used. Clean, simple, smart.
        </p>
        <p class="apple-body" style="color: var(--apple-gray);">
          Designed for life on the road.
        </p>
      </div>
      <div style="height: 400px; border-radius: 18px; display: flex; align-items: center; justify-content: center; padding: 40px;">
        <img src="/images/pickpod-product.png" alt="PickPod Product" style="max-width: 100%; max-height: 100%; object-fit: contain;">
      </div>
    </div>
  </div>
</section>

<!-- Features Section -->
<section id="features" class="apple-section" style="background: white;">
  <div class="apple-container">
    <h2 class="apple-headline" style="font-size: 48px; text-align: center; margin-bottom: 60px;">
      Every detail matters.
    </h2>
    <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 30px;">
      <div class="apple-card">
        <h3 style="font-size: 24px; font-weight: 600; margin-bottom: 12px;">Dual Chamber</h3>
        <p class="apple-body">Separate compartments for fresh and used picks. Stay organized, stay clean.</p>
      </div>
      <div class="apple-card">
        <h3 style="font-size: 24px; font-weight: 600; margin-bottom: 12px;">Easy Mount</h3>
        <p class="apple-body">Installs in seconds. Fits any car interior. No tools required.</p>
      </div>
      <div class="apple-card">
        <h3 style="font-size: 24px; font-weight: 600; margin-bottom: 12px;">Premium Design</h3>
        <p class="apple-body">Sleek, minimal aesthetics that complement your car's interior.</p>
      </div>
    </div>
  </div>
</section>

