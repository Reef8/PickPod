<!-- Navigation -->
<nav class="nav" id="navbar">
  <div class="container">
    <a href="/" class="nav-logo">PickPod</a>
    <ul class="nav-links">
      <li><a href="#product">Product</a></li>
      <li><a href="#features">Features</a></li>
      <li><a href="/testimonials">Testimonials</a></li>
    </ul>
    <a href="#notify" class="nav-cta">Get Notified</a>
  </div>
</nav>

<!-- Hero Section -->
<section class="hero">
  <div class="container">
    <div class="hero-split">
      <div class="hero-text">
        <span class="hero-badge animate-fade-up animated">Version 2 Coming Soon</span>
        <h1 class="headline-xl mb-3 animate-fade-up animated delay-100">
          Made for people who floss in their car.
        </h1>
        <p class="body-lg text-muted animate-fade-up animated delay-150">
          PickPod keeps fresh picks organized and used ones out of sight.
        </p>
      </div>
      <div class="hero-image animate-scale-in animated delay-200">
        <img src="/images/pickpod3.PNG" alt="PickPod Product">
      </div>
    </div>
    <!-- Signup Section - Centered Below Hero -->
    <div class="hero-signup-centered animate-fade-up animated delay-300">
      <p class="hero-signup-label">Join 2,000+ on the waitlist</p>
      <%= if @form_status == :success do %>
        <div class="signup-success">
          <p>You're on the list! Check your email for confirmation.</p>
        </div>
      <% else %>
        <.form for={@changeset} action={~p"/subscribe"} class="signup-form" id="hero-signup-form">
          <div class="form-field">
            <input
              type="email"
              name="waitlist_email[email]"
              value={@changeset.changes[:email] || ""}
              placeholder="Enter your email"
              required
              class={"form-input #{if Keyword.get(@changeset.errors, :email), do: "form-input-error"}"}
            />
            <%= if error = Keyword.get(@changeset.errors, :email) do %>
              <p class="form-error"><%= elem(error, 0) %></p>
            <% end %>
          </div>
          <button type="submit" class="btn btn-primary btn-lg">
            Notify Me
          </button>
        </.form>
      <% end %>
    </div>
    <!-- Mini Testimonials Strip -->
    <div class="hero-testimonials animate-fade-up animated delay-400">
      <div class="hero-testimonial-item">
        <div class="hero-testimonial-stars">★★★★★</div>
        <p class="hero-testimonial-text">"Finally, a solution for my messy car flossing habit!"</p>
        <span class="hero-testimonial-author">— Sarah K., NYC</span>
      </div>
      <div class="hero-testimonial-item">
        <div class="hero-testimonial-stars">★★★★★</div>
        <p class="hero-testimonial-text">"Game changer for after lunch meetings."</p>
        <span class="hero-testimonial-author">— Michael J., LA</span>
      </div>
      <div class="hero-testimonial-item">
        <div class="hero-testimonial-stars">★★★★★</div>
        <p class="hero-testimonial-text">"No more hurting gums!"</p>
        <span class="hero-testimonial-author">— Emma R., Chicago</span>
      </div>
    </div>
  </div>
</section>

<!-- Problem Section -->
<section id="product" class="section">
  <div class="container text-center">
    <span class="label animate-on-scroll">The Problem</span>
    <h2 class="headline-lg mb-4 animate-on-scroll">
      The flossing problem everyone ignores.
    </h2>
    <p class="body-lg animate-on-scroll" style="max-width: 600px; margin: 0 auto;">
      Floss picks in your car end up everywhere—cupholders, door pockets, center consoles. Messy, unsanitary, forgotten.
    </p>
  </div>
</section>

<!-- Solution Section -->
<section class="section-light section">
  <div class="container">
    <div class="hero-split" style="gap: 5rem;">
      <div class="hero-image animate-slide-left">
        <img src="/images/pickpod3.PNG" alt="PickPod Product" style="max-width: 400px;">
      </div>
      <div>
        <span class="label animate-on-scroll">The Solution</span>
        <h2 class="headline-md mb-3 animate-on-scroll">
          Organized. Accessible. Clean.
        </h2>
        <div class="divider animate-on-scroll"></div>
        <p class="body-lg mb-4 animate-on-scroll">
          PickPod fits seamlessly in all cup holders, keeping fresh picks easily accessible and used picks out of sight.
        </p>
        <p class="body-base text-muted mb-5 animate-on-scroll">
          Two chambers. One for fresh picks, one for used. Clean, simple, smart.
        </p>
        <a href="#features" class="btn btn-secondary animate-on-scroll">See Features</a>
      </div>
    </div>
  </div>
</section>

<!-- Features Section -->
<section id="features" class="section">
  <div class="container">
    <div class="text-center mb-6">
      <span class="label animate-on-scroll">Features</span>
      <h2 class="headline-lg animate-on-scroll">Designed with intention.</h2>
    </div>
    <div class="feature-grid animate-stagger">
      <div class="feature-item animate-fade-up">
        <span class="feature-number">1</span>
        <h3 class="feature-title">Dual Chamber</h3>
        <p class="feature-description">
          Separate compartments for fresh and used picks. Stay organized, stay clean.
        </p>
      </div>
      <div class="feature-item animate-fade-up">
        <span class="feature-number">2</span>
        <h3 class="feature-title">Easy Install</h3>
        <p class="feature-description">
          Installs in seconds. Fits any cup holder. No tools required.
        </p>
      </div>
      <div class="feature-item animate-fade-up">
        <span class="feature-number">3</span>
        <h3 class="feature-title">Premium Design</h3>
        <p class="feature-description">
          Sleek, minimal aesthetics that complement your car's interior.
        </p>
      </div>
      <div class="feature-item animate-fade-up">
        <span class="feature-number">4</span>
        <h3 class="feature-title">Easy Dispense</h3>
        <p class="feature-description">
          Quick-click bottom releases used picks straight into the trash. No mess, no fuss.
        </p>
      </div>
    </div>
  </div>
</section>


<!-- How It Works -->
<section class="section">
  <div class="container">
    <div class="hero-split" style="gap: 5rem;">
      <div>
        <span class="label animate-on-scroll">How It Works</span>
        <h2 class="headline-md mb-4 animate-on-scroll">Simple by design.</h2>
        <div class="divider animate-on-scroll"></div>
        <div class="mb-4">
          <p class="body-base mb-3 animate-on-scroll"><strong class="text-accent">1.</strong> Place PickPod in your cup holder</p>
          <p class="body-base mb-3 animate-on-scroll"><strong class="text-accent">2.</strong> Fill the fresh chamber with floss picks</p>
          <p class="body-base mb-3 animate-on-scroll"><strong class="text-accent">3.</strong> Use and dispose in the used chamber</p>
          <p class="body-base animate-on-scroll"><strong class="text-accent">4.</strong> Empty and refill as needed</p>
        </div>
      </div>
      <div class="hero-image animate-slide-right">
        <img src="/images/pickpod3.PNG" alt="How to use PickPod" style="max-width: 100%; border-radius: var(--radius-lg);">
      </div>
    </div>
  </div>
</section>

<!-- CTA Section -->
<section id="notify" class="section">
  <div class="container">
    <div class="signup-box animate-scale-in">
      <span class="label">Be First</span>
      <h2 class="headline-md mb-3">
        Your smile will thank you.
      </h2>
      <p class="body-lg text-muted mb-5" style="max-width: 500px; margin-left: auto; margin-right: auto;">
        Join the waitlist and be the first to know when PickPod launches.
      </p>
<%= if @form_status == :success do %>
        <div class="signup-success">
          <p>You're on the list! Check your email for confirmation.</p>
        </div>
      <% else %>
        <.form for={@changeset} action={~p"/subscribe"} class="signup-form" id="cta-signup-form">
          <div class="form-field">
            <input
              type="email"
              name="waitlist_email[email]"
              value={@changeset.changes[:email] || ""}
              placeholder="Enter your email"
              required
              class={"form-input #{if Keyword.get(@changeset.errors, :email), do: "form-input-error"}"}
            />
            <%= if error = Keyword.get(@changeset.errors, :email) do %>
              <p class="form-error"><%= elem(error, 0) %></p>
            <% end %>
          </div>
          <button type="submit" class="btn btn-primary btn-lg">
            Notify Me
          </button>
        </.form>
      <% end %>
      <p class="body-sm text-muted mt-4">
        No spam. Unsubscribe anytime.
      </p>
    </div>
  </div>
</section>

<!-- Footer -->
<footer class="footer">
  <div class="container">
    <div class="footer-grid">
      <div>
        <div class="footer-logo">PickPod</div>
        <p class="footer-description">
          The dual-chamber car floss pick dispenser designed for busy professionals.
        </p>
      </div>
      <div>
        <h4 class="footer-heading">Navigation</h4>
        <ul class="footer-links">
          <li><a href="#product">Product</a></li>
          <li><a href="#features">Features</a></li>
          <li><a href="/testimonials">Testimonials</a></li>
        </ul>
      </div>
      <div>
        <h4 class="footer-heading">Social</h4>
        <ul class="footer-links">
          <li><a href="#">Instagram</a></li>
          <li><a href="#">Twitter</a></li>
          <li><a href="#">Facebook</a></li>
        </ul>
      </div>
      <div>
        <h4 class="footer-heading">Contact</h4>
        <ul class="footer-links">
          <li><a href="mailto:hello@pickpod.com">hello@pickpod.com</a></li>
        </ul>
      </div>
    </div>
    <div class="footer-bottom">
      <p>&copy; 2025 PickPod. All rights reserved.</p>
      <p>Designed with care.</p>
    </div>
  </div>
</footer>

<!-- Social Proof Banner -->
<div id="social-proof-banner" class="social-proof-banner">
  <div class="social-proof-icon">
    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
    </svg>
  </div>
  <div class="social-proof-content">
    <div class="social-proof-text" id="social-proof-text"></div>
    <div class="social-proof-time" id="social-proof-time"></div>
  </div>
  <button class="social-proof-close" id="social-proof-close" aria-label="Close notification">
    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
    </svg>
  </button>
</div>

<script>
  // Navbar scroll effect
  window.addEventListener('scroll', function() {
    const nav = document.getElementById('navbar');
    if (window.scrollY > 50) {
      nav.classList.add('nav-scrolled');
    } else {
      nav.classList.remove('nav-scrolled');
    }
  });

  // Social Proof Banner - Fake customer data
  (function() {
    const customers = [
      { name: "Sarah", city: "New York", timeAgo: "2 min ago" },
      { name: "Michael", city: "Los Angeles", timeAgo: "5 min ago" },
      { name: "Emma", city: "Chicago", timeAgo: "8 min ago" },
      { name: "James", city: "Houston", timeAgo: "12 min ago" },
      { name: "Olivia", city: "Phoenix", timeAgo: "15 min ago" },
      { name: "William", city: "Philadelphia", timeAgo: "18 min ago" },
      { name: "Sophia", city: "San Antonio", timeAgo: "22 min ago" },
      { name: "Benjamin", city: "San Diego", timeAgo: "25 min ago" },
      { name: "Isabella", city: "Dallas", timeAgo: "28 min ago" },
      { name: "Lucas", city: "Austin", timeAgo: "32 min ago" },
      { name: "Mia", city: "Seattle", timeAgo: "35 min ago" },
      { name: "Henry", city: "Denver", timeAgo: "38 min ago" },
      { name: "Charlotte", city: "Boston", timeAgo: "42 min ago" },
      { name: "Alexander", city: "Miami", timeAgo: "45 min ago" },
      { name: "Amelia", city: "Atlanta", timeAgo: "48 min ago" }
    ];

    const banner = document.getElementById('social-proof-banner');
    const textEl = document.getElementById('social-proof-text');
    const timeEl = document.getElementById('social-proof-time');
    const closeBtn = document.getElementById('social-proof-close');

    let currentIndex = 0;
    let isVisible = false;
    let isClosed = false;
    let intervalId = null;

    function showBanner() {
      if (isClosed) return;

      const customer = customers[currentIndex];
      textEl.innerHTML = `<strong>${customer.name}</strong> from ${customer.city} joined the waitlist`;
      timeEl.textContent = customer.timeAgo;

      banner.classList.add('visible');
      banner.classList.remove('hidden');
      isVisible = true;
    }

    function hideBanner() {
      banner.classList.remove('visible');
      banner.classList.add('hidden');
      isVisible = false;
    }

    function nextCustomer() {
      if (isClosed) return;

      if (isVisible) {
        hideBanner();
        setTimeout(() => {
          currentIndex = (currentIndex + 1) % customers.length;
          showBanner();
        }, 500);
      } else {
        showBanner();
      }
    }

    // Close button functionality
    closeBtn.addEventListener('click', function() {
      isClosed = true;
      hideBanner();
      if (intervalId) {
        clearInterval(intervalId);
      }
    });

    // Start after 3 seconds
    setTimeout(() => {
      showBanner();
      // Cycle every 6 seconds
      intervalId = setInterval(nextCustomer, 6000);
    }, 3000);
  })();

  // Scroll Animation Observer
  (function() {
    const animatedElements = document.querySelectorAll(
      '.animate-on-scroll, .animate-fade-up, .animate-fade-in, .animate-slide-left, .animate-slide-right, .animate-scale-in'
    );

    // Skip elements that already have 'animated' class (hero section)
    const elementsToObserve = Array.from(animatedElements).filter(
      el => !el.classList.contains('animated')
    );

    const observerOptions = {
      root: null,
      rootMargin: '0px 0px -50px 0px',
      threshold: 0.1
    };

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('animated');
          observer.unobserve(entry.target);
        }
      });
    }, observerOptions);

    elementsToObserve.forEach(el => observer.observe(el));
  })();
</script>
