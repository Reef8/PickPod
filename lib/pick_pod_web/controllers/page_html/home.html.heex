      <li><a href="#features">Features</a></li>
      <li><a href="/about">About</a></li>
    </ul>
    <a href="#notify" class="nav-cta">Get Notified</a>
  </div>
</nav>

<!-- Hero Section -->
<section class="hero">
  <div class="container">
    <div class="hero-split">
      <div class="hero-text">
        <span class="hero-badge">Coming Soon</span>
        <h1 class="headline-xl mb-4">
          Floss on the go.<br><span class="text-gradient">Never miss a beat.</span>
        </h1>
        <p class="subheadline mb-6">
          The dual-chamber car floss pick dispenser designed for busy professionals who care about their smile.
        </p>
        <div style="display: flex; gap: 1rem; flex-wrap: wrap;">
          <a href="#notify" class="btn btn-primary btn-lg">Join the Waitlist</a>
          <a href="#product" class="btn btn-outline btn-lg">Learn More</a>
        </div>
      </div>
      <div class="hero-image">
        <img src="/images/pickpod-product.png" alt="PickPod Product">
      </div>
    </div>
  </div>
</section>

<!-- Problem Section -->
<section id="product" class="section">
  <div class="container text-center">
    <span class="label">The Problem</span>
    <h2 class="headline-lg mb-4">
      The flossing problem everyone ignores.
    </h2>
    <p class="body-lg" style="max-width: 600px; margin: 0 auto;">
      You know you should floss after meals. But carrying floss picks in your car?
      They end up everywhere. Messy. Inconvenient. Forgotten.
    </p>
  </div>
</section>

<!-- Solution Section -->
<section class="section-light section">
  <div class="container">
    <div class="hero-split" style="gap: 5rem;">
      <div class="hero-image">
        <img src="/images/pickpod-product.png" alt="PickPod Product" style="max-width: 400px;">
      </div>
      <div>
        <span class="label">The Solution</span>
        <h2 class="headline-md mb-3">
          Organized. Accessible. Brilliant.
        </h2>
        <div class="divider"></div>
        <p class="body-lg mb-4">
          PickPod mounts seamlessly in your car, keeping fresh floss picks exactly where you need them.
        </p>
        <p class="body-base text-muted mb-5">
          Two chambers. One for fresh picks, one for used. Clean, simple, smart.
        </p>
        <a href="#features" class="btn btn-secondary">See Features</a>
      </div>
    </div>
  </div>
</section>

<!-- Features Section -->
<section id="features" class="section">
  <div class="container">
    <div class="text-center mb-6">
      <span class="label">Features</span>
      <h2 class="headline-lg">Every detail matters.</h2>
    </div>
    <div class="feature-grid">
      <div class="feature-item">
        <span class="feature-number">1</span>
        <h3 class="feature-title">Dual Chamber</h3>
        <p class="feature-description">
          Separate compartments for fresh and used picks. Stay organized, stay clean.
        </p>
      </div>
      <div class="feature-item">
        <span class="feature-number">2</span>
        <h3 class="feature-title">Easy Mount</h3>
        <p class="feature-description">
          Installs in seconds. Fits any car interior. No tools required.
        </p>
      </div>
      <div class="feature-item">
        <span class="feature-number">3</span>
        <h3 class="feature-title">Premium Design</h3>
        <p class="feature-description">
          Sleek, minimal aesthetics that complement your car's interior.
        </p>
      </div>
    </div>
  </div>
</section>

<!-- How It Works -->
<section class="section-light section">
  <div class="container">
    <div class="hero-split" style="gap: 5rem;">
      <div>
        <span class="label">How It Works</span>
        <h2 class="headline-md mb-4">Simple by design.</h2>
        <div class="divider"></div>
        <div class="mb-4">
          <p class="body-base mb-3"><strong class="text-accent">1.</strong> Mount PickPod to your preferred location</p>
          <p class="body-base mb-3"><strong class="text-accent">2.</strong> Fill the fresh chamber with floss picks</p>
          <p class="body-base mb-3"><strong class="text-accent">3.</strong> Use and dispose in the used chamber</p>
          <p class="body-base"><strong class="text-accent">4.</strong> Empty and refill as needed</p>
        </div>
      </div>
      <div class="hero-image">
        <img src="/images/pickpod-how-to-use.png" alt="How to use PickPod" style="max-width: 100%; border-radius: var(--radius-lg);">
      </div>
    </div>
  </div>
</section>

<!-- CTA Section -->
<section id="notify" class="section">
  <div class="container">
    <div class="signup-box">
      <span class="label">Be First</span>
      <h2 class="headline-md mb-3">
        Your smile will thank you.
      </h2>
      <p class="body-lg text-muted mb-5" style="max-width: 500px; margin-left: auto; margin-right: auto;">
        Join the waitlist and be the first to know when PickPod launches.
      </p>
      <form class="signup-form">
        <input
          type="email"
          placeholder="Enter your email"
          class="form-input"
          required
        />
        <button type="submit" class="btn btn-primary btn-lg">
          Notify Me
        </button>
      </form>
      <p class="body-sm text-muted mt-4">
        No spam. Unsubscribe anytime.
      </p>
    </div>
  </div>
</section>

